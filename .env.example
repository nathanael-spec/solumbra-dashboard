# Solumbra dashboard, settings.
#
# `npm run setup` fills this in for you and saves it as .env.local, which git
# never sees. This file is the map of what exists. One block per value: what
# the tool is, where to click, then the empty line to paste into.
# Click by click screenshots free steps are in docs/keys.md.

# ---------------------------------------------------------------- Your business
# Shown top left and in the browser tab.
BUSINESS_NAME=
# Where you are. Decides what "today" and "this week" mean. IANA name, like
# America/Chicago, Europe/Madrid, Asia/Manila.
TIMEZONE=
# Three letter code: USD, EUR, GBP, MXN, PHP.
CURRENCY=
# The ways clients find you, comma separated. Every money row in the Ledger
# carries one of these, or Overhead. The Money page compares them.
CHANNELS=Upwork, Cold email, Network, Website
# What money comes in for. Used by the Add button.
CATEGORIES=Consultation, Build, Maintenance, Training, Other
# Share of profit to set aside for tax. 0.28 means 28%. 0 hides the line.
TAX_RATE=0.28
# Optional. /logo.png after `npm run setup` copies your logo, or any https address.
LOGO_URL=
# Optional. A page listing your proposals. Set it and a Proposals link appears
# in the sidebar, opening in a new tab. Left empty, no link shows.
# Point it at a page that actually lists them, not at a site root that is
# deliberately blank, or the link lands on an empty screen.
PROPOSALS_URL=

# ---------------------------------------------------------------- The password
# One password. Anyone with it sees everything. Setup makes one if you leave it empty.
DASHBOARD_PASSWORD=
# Signs the login cookie. Any long random string. Setup makes it.
DASHBOARD_SESSION_SECRET=

# ---------------------------------------------------------------- Google Sheets
# A service account: a robot Google user with its own email. You share your
# sheet with that email as Editor and it reads and writes the tabs.
#   1. console.cloud.google.com, top left project menu, New project, Create.
#   2. APIs and services, Library, search "Google Sheets API", Enable.
#   3. APIs and services, Credentials, Create credentials, Service account, Done.
#   4. Click the account, Keys, Add key, Create new key, JSON. A file downloads.
#   5. Open the file and paste its whole content here, in single quotes.
# The file is a password. Google shows it once. Keep it out of chat and email.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The other way in, if you prefer your own Google login: an OAuth client id and
# secret plus a refresh token limited to the spreadsheets scope. Leave empty
# when the service account above is set.
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REFRESH_TOKEN=
# The P&L sheet. The long id in its address, between /d/ and /edit.
# It needs a Ledger tab and a Recurring tab. docs/sheets.md has the columns.
PNL_SHEET_ID=
# Where the dashboard's own tabs live (Stage log, Notes, Cold email runs, and
# Pipeline if you keep the pipeline in a sheet). Same id as above is fine.
DASHBOARD_SHEET_ID=

# ---------------------------------------------------------------- The pipeline
# clickup, sheet, or none. Setup decides this from your answers.
PIPELINE_SOURCE=
# ClickUp, the CRM. Your avatar bottom left, Settings, Apps, API Token, Generate.
# The token starts with pk_. Header is the bare token, no "Bearer". 100 requests a minute.
CLICKUP_API_TOKEN=
# The workspace id and the list id of the pipeline. Setup lists them for you.
# The list id is also the number in the list's address after /li/.
CLICKUP_TEAM_ID=
CLICKUP_LIST_ID=
# Written by `npm run deploy` when it creates the webhook. Do not fill by hand.
CLICKUP_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Optional tools
# Cal.com, the booking page. Settings, Developer, API keys, Add. Starts with cal_.
CALCOM_API_KEY=
# Instantly, the cold email sender. Settings, Integrations, API keys, Create,
# all scopes. Shown once. 20 requests a minute; the dashboard uses five per refresh.
INSTANTLY_API_KEY=
# The timezone your Instantly campaign schedules are set in. Empty means TIMEZONE.
INSTANTLY_TIMEZONE=
# Vollna, the only readable source of Upwork proposal results. vollna.com,
# Settings, API. Reading your own proposals is free. Job posts cost credits
# and the dashboard never asks for them. 30 requests a minute.
VOLLNA_API_TOKEN=
# Which Upwork profile in Vollna, if you have several. Setup picks it.
VOLLNA_PROFILE_ID=
# Stripe, balance only. Developers, API keys, Create restricted key, give it
# Balance: Read and nothing else. Starts with rk_live_. Shown once.
STRIPE_API_KEY=
